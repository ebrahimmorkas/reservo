# Copy to .env and adjust. Every value has a sensible default for local development.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite. Example: postgres://reservo:reservo@localhost:5432/reservo
DATABASE_URL=

# Optional. When empty, Reservo uses an in-memory cache and runs Celery tasks
# synchronously, so the project works without Redis. Example: redis://localhost:6379/0
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Reservo <no-reply@reservo.local>
